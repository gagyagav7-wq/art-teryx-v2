# ===========================================
# ART'TERYX MEDIA DOWNLOADER - CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram API Credentials (from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Bot Username (without @)
BOT_USERNAME=your_bot_username

# Target Group ID for cloud storage (must be a supergroup with topics enabled)
GROUP_ID=-100xxxxxxxxxx

# Web App URL (your deployed Flask app URL)
WEB_APP_URL=https://your-domain.com

# Admin User IDs (comma-separated Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Flask Secret Key (generate a random string)
SECRET_KEY=your_random_secret_key_here
